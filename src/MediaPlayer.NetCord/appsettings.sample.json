{
  "Discord": {
    "Token": ""
  },
  "FfmpegOptions": {
    "FfmpegPath": "ffmpeg"
  },
  "YtDlpOptions": {
    "YtDlpPath": "yt-dlp",
    "UseCookies": "true",
    "CookiesFile": "cookies.txt",
    "CookiesFromBrowser": "chrome"
  },
  "TrackResolverOptions": {
    "CacheTtl": "1.00:00:00"
  },
  "RadioOptions": {
    "Stations": {
      "EuropaFM": "https://astreaming.edi.ro:8443/EuropaFM_aac",
      "RockFM": "https://live.rockfm.ro/rockfm.aacp",
      "DigiFM": "https://edge76.rcs-rds.ro/digifm/digifm.mp3",
      "KissFM": "https://live.kissfm.ro/kissfm.aacp",
      "MagicFM": "https://live.magicfm.ro/magicfm.aacp",
      "RadioZU": "https://live3ro.antenaplay.ro/radiozu/radiozu-48000.m3u8",
      "RadioSomes": "https://evcast01.mediacp.eu/somes",
      "Taraf": "https://ddos.radiotaraf.ro/8181/stream",
      "ProFM": "https://edge76.rcs-rds.ro/profm/profm.mp3",
      "Trinitas": "https://live.radiotrinitas.ro:8003"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "NetCord": "Information",
      "MediaPlayer": "Debug"
    }
  },
  "easycaching": {
    "redis": {
      "SerializerName": "json",
      "dbconfig": {
        "AsyncTimeout": 1000,
        "SyncTimeout": 1000,
        "Endpoints": [
          {
            "Host": "localhost",
            "Port": 6379
          }
        ]
      }
    },
    "sqlite": {
      "dbconfig": {
        "FileName": "track-request-cache.db"
      }
    }
  }
}
